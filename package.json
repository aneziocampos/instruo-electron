{
  "name": "instruo-desktop",
  "version": "0.1.0",
  "description": "Instruo Desktop — Record step-by-step guides from any application",
  "main": "./out/main/index.js",
  "homepage": "https://instruo.ai",
  "author": "Instruo <noreply@instruo.ai>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "package": "electron-vite build && electron-builder --win --x64",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:dir": "electron-vite build && electron-builder --dir",
    "dev:mac-hooks": "electron-vite build && electron-builder --dir && open dist/mac-arm64/Instruo.app",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@img/sharp-darwin-arm64": "^0.33.5",
    "electron-log": "^5.3.0",
    "electron-store": "^10.0.0",
    "instruo-native": "file:native",
    "sharp": "^0.33.5",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.0",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
